{
  "buildCommand": "npm run vercel-build",
  "cleanUrls": true,
  "functions": {
    "api/kaisetsu.js": {
      "includeFiles": "data/kaisetsu/**"
    },
    "api/kaisetsu-full.js": {
      "includeFiles": "data/kaisetsu/**"
