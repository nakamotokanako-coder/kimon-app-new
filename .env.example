# Phase 3b-1 認証基盤で参照する環境変数（値はダミー。実値は Vercel の環境変数に設定）。

# セッションCookie署名用シークレット（必須・十分長いランダム文字列）
SESSION_SECRET=change-me-to-a-long-random-string

# Upstash Redis（@upstash/redis の Redis.fromEnv() が参照）
# Vercel の Upstash 連携で自動注入される場合は KV_REST_API_URL/KV_REST_API_TOKEN でも可。
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example-token

# Resend（マジックリンク送信）
RESEND_API_KEY=re_example
# 送信元アドレス（Resendで検証済みドメインのもの）
MAGIC_LINK_FROM=login@your-verified-domain.example

# マジックリンクの origin。本番のカスタムドメインを固定したい場合のみ設定。
# 未設定でも Vercel の VERCEL_URL（各デプロイURL）から自動で組まれる。
# APP_BASE_URL=https://your-production-domain.example
